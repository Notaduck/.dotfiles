# Ghostty is the backup terminal; Tern is the main one. Keep Ghostty's native
# TERM (xterm-ghostty); do not override it with xterm-256color.

font-family = JetBrainsMono Nerd Font
font-style = Regular
font-style-bold = Bold
font-style-italic = Italic
font-style-bold-italic = "Bold Italic"
font-size = 15

# `theme <name>` writes ~/.local/state/theme/ghostty, which overrides the theme
# below. The line here is only the fallback before that command has ever run.
theme = Catppuccin Mocha
config-file = ?~/.local/state/theme/ghostty
background-opacity = 1.0
window-padding-x = 25
window-padding-y = 20

keybind = ctrl+tab=esc:[1;5I
keybind = ctrl+shift+tab=esc:[1;6I
