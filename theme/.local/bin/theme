#!/usr/bin/env bash
# theme: switch Ghostty, Neovim, bat, omp and Tern to one colour scheme.
# tmux is not switched: ~/.tmux.conf always sources the catppuccin-mocha palette.
#
#   theme                  open the picker (needs fzf) when run from a terminal
#   theme <name>           switch every program to <name>, reload the running ones
#   theme list             list the known themes
#   theme current          print the active theme
#   theme toggle           switch to the next theme in the list
#   theme preview <name>   render a palette preview (what the picker shows)
#
# Themes are palette files in ~/.config/theme/palettes/<name>.conf, stowed from
# the dotfiles repo. Each carries the colours plus the per-app names
# (@thm_nvim, @thm_ghostty, @thm_bat, @thm_omp), so adding a theme is adding a file.
#
# The active choice lives in ~/.local/state/theme, outside the repo:
#   current     theme name; read by Neovim (lua/config/theme.lua)
#   ghostty     `theme = ...` line, included from ~/.config/ghostty/config
#   bat         bat theme name; ~/.zshrc exports it as BAT_THEME
# omp's theme goes to both slots of theme.dark/theme.light in ~/.omp/agent/config.yml
# (tracked in the dotfiles repo). Tern follows omp's theme while its own
# theme_dark/theme_light settings are unset.
set -euo pipefail

PALETTES="${XDG_CONFIG_HOME:-$HOME/.config}/theme/palettes"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/theme"
DEFAULT=catppuccin-mocha
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"
R=$'\033[0m'

usage() {
  sed -n '2,11p' "$SELF" | sed 's/^# \{0,1\}//'
}

palette_file() {
  echo "$PALETTES/$1.conf"
}

# palette_get <theme> <key>: value of @thm_<key> in the palette file
palette_get() {
  sed -n "s/^set -g @thm_$2 *\"\([^\"]*\)\".*/\1/p" "$(palette_file "$1")"
}

list() {
  local f
  for f in "$PALETTES"/*.conf; do
    [ -e "$f" ] || continue
    basename "$f" .conf
  done
}

current() {
  local name=""
  [ -r "$STATE_DIR/current" ] && name=$(<"$STATE_DIR/current")
  if [ -n "$name" ] && [ -r "$(palette_file "$name")" ]; then
    echo "$name"
  else
    echo "$DEFAULT"
  fi
}

next_theme() {
  local cur first="" prev="" t
  cur=$(current)
  for t in $(list); do
    [ -z "$first" ] && first=$t
    [ "$prev" = "$cur" ] && { echo "$t"; return; }
    prev=$t
  done
  echo "$first"
}

# ---------- state + reloads ----------

write_state() {
  local name=$1
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$name" > "$STATE_DIR/current"
  printf 'theme = %s\n' "$(palette_get "$name" ghostty)" > "$STATE_DIR/ghostty"
  printf '%s\n' "$(palette_get "$name" bat)" > "$STATE_DIR/bat"
}

omp_bin() {
  local tern_omp="$HOME/Library/Application Support/Tern/omp/bin/omp"
  if command -v omp > /dev/null 2>&1; then
    command -v omp
  elif [ -x "$tern_omp" ]; then
    echo "$tern_omp"
  fi
}

# Both slots get the same theme, so omp and Tern show it whatever the system
# appearance. Tern re-reads config.yml when it changes.
set_omp() {
  local name=$1 omp t
  t=$(palette_get "$name" omp)
  omp=$(omp_bin)
  if [ -z "$omp" ]; then
    echo "omp: not installed, skipped"
    return
  fi
  if "$omp" config set theme.dark "$t" > /dev/null && "$omp" config set theme.light "$t" > /dev/null; then
    echo "omp + Tern: $t"
  else
    echo "omp: setting theme $t failed" >&2
  fi
}

reload_nvim() {
  local dir sock n=0 stale=0
  for dir in "${XDG_RUNTIME_DIR:-}" "${TMPDIR:-}" /tmp; do
    [ -n "$dir" ] && [ -d "$dir/nvim.$USER" ] || continue
    for sock in "$dir/nvim.$USER"/*/nvim.*.0; do
      [ -S "$sock" ] || continue
      if nvim --server "$sock" --remote-expr 'v:lua.require("config.theme").apply()' > /dev/null 2>&1; then
        n=$((n + 1))
      else
        stale=$((stale + 1))
      fi
    done
  done
  if [ "$n" -eq 0 ] && [ "$stale" -eq 0 ]; then
    echo "nvim: not running"
    return
  fi
  local msg="nvim: reloaded $n instance(s)"
  [ "$stale" -gt 0 ] && msg="$msg, $stale stale socket(s) skipped"
  echo "$msg"
}

reload_ghostty() {
  pgrep -xq ghostty || { echo "ghostty: not running"; return; }
  # Same as pressing cmd+shift+, in Ghostty. Needs Accessibility access for the
  # app running this script (System Settings > Privacy & Security > Accessibility).
  if osascript > /dev/null 2>&1 <<'AS'
tell application "System Events" to tell process "Ghostty"
  click menu item "Reload Configuration" of menu 1 of menu bar item "Ghostty" of menu bar 1
end tell
AS
  then
    echo "ghostty: reloaded"
  else
    echo "ghostty: press cmd+shift+, to reload (no Accessibility access)"
  fi
}

switch_to() {
  local name=$1
  if [ ! -r "$(palette_file "$name")" ]; then
    echo "theme: unknown theme '$name'. Run 'theme list'." >&2
    return 1
  fi
  write_state "$name"
  echo "theme: $name"
  reload_ghostty
  set_omp "$name"
  reload_nvim
  echo "bat: $(palette_get "$name" bat) in new shells"
}

# ---------- preview + picker ----------

fgc() { printf '\033[38;2;%d;%d;%dm' "0x${1:1:2}" "0x${1:3:2}" "0x${1:5:2}"; }
bgc() { printf '\033[48;2;%d;%d;%dm' "0x${1:1:2}" "0x${1:3:2}" "0x${1:5:2}"; }

# row <content>: one line of the mock window, padded with the background colour.
# Content is ASCII plus colour escapes, so byte count equals visible width.
row() {
  local s=$1 vis pad
  vis=$(printf '%s' "$s" | sed $'s/\033\\[[0-9;]*m//g' | wc -c | tr -d ' ')
  pad=$(( _W - vis ))
  [ "$pad" -lt 0 ] && pad=0
  printf '%s%s%*s%s\n' "$_N" "$s" "$pad" '' "$R"
}

preview() {
  local name=$1
  [ -r "$(palette_file "$name")" ] || { echo "theme: no palette for '$name'" >&2; return 1; }
  local mode bg surface border text subtle muted accent on_accent insert visual warn alert k
  for k in mode bg surface border text subtle muted accent on_accent insert visual warn alert; do
    eval "$k=\$(palette_get \"\$name\" $k)"
  done
  _W=${FZF_PREVIEW_COLUMNS:-${COLUMNS:-72}}
  _N="$(bgc "$bg")$(fgc "$text")"
  local A N tag=""
  A="$(bgc "$accent")$(fgc "$on_accent")"
  N=$_N
  [ "$name" = "$(current)" ] && tag="  active"

  printf '\n  %s%s%s  %s%s%s%s\n\n' "$(fgc "$accent")" "$name" "$R" "$(fgc "$muted")" "$mode" "$tag" "$R"

  local i=0 v
  for k in bg surface border text subtle muted accent on_accent insert visual warn alert; do
    v=${!k}
    printf '  %s%s%s %-10s' "$(fgc "$v")" "██" "$R" "$k"
    i=$((i + 1))
    [ $((i % 3)) -eq 0 ] && printf '\n'
  done
  printf '\n'

  local rule
  rule=$(printf '%*s' $(( _W > 8 ? _W - 4 : 4 )) '' | tr ' ' '-')
  row ""
  row "  $(fgc "$subtle")dotfiles$N  $A nvim $N $(fgc "$subtle") api $N $(fgc "$muted") logs $N"
  row "  $(fgc "$border")$rule$N"
  row ""
  row "  $(fgc "$insert")~/.dotfiles$N $(fgc "$accent")>$N theme pick"
  row ""
  row "  $(fgc "$muted")-- lua/config/theme.lua$N"
  row "  $(fgc "$accent")local function$N $(fgc "$insert")apply$N(name)"
  row "    $(fgc "$accent")if not$N palettes[name] $(fgc "$accent")then$N"
  row "      vim.notify($(fgc "$warn")\"unknown theme\"$N, $(fgc "$alert")levels.ERROR$N)"
  row "    $(fgc "$accent")end$N"
  row "    $(fgc "$visual")vim.cmd.colorscheme$N(name)"
  row "  $(fgc "$accent")end$N"
  row ""
  row "  $(fgc "$alert")E 1$N  $(fgc "$warn")W 2$N  $(fgc "$muted")main  12:3$N"
  row ""
}

pick() {
  if ! command -v fzf > /dev/null 2>&1; then
    echo "theme: fzf is not installed; use 'theme <name>'" >&2
    return 1
  fi
  local cur choice pos=1 i=0 t
  cur=$(current)
  for t in $(list); do
    i=$((i + 1))
    [ "$t" = "$cur" ] && pos=$i
  done
  choice=$(list | fzf \
    --prompt 'theme > ' \
    --header "active: $cur   enter: apply   esc: keep" \
    --no-sort --cycle --layout reverse --no-multi --info hidden \
    --bind "start:pos($pos)" \
    --preview "'$SELF' preview {}" \
    --preview-window 'right,65%,border-left,nowrap') || return 0
  [ -n "$choice" ] && switch_to "$choice"
}

case "${1:-}" in
  "")
    if [ -t 1 ] && command -v fzf > /dev/null 2>&1; then
      pick
    else
      current
    fi
    ;;
  current) current ;;
  list) list ;;
  pick) pick ;;
  toggle) switch_to "$(next_theme)" ;;
  preview)
    [ -n "${2:-}" ] || { usage >&2; exit 1; }
    preview "$2"
    ;;
  -h|--help|help) usage ;;
  *) switch_to "$1" ;;
esac
